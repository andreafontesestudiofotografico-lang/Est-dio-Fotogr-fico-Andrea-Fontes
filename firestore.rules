rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "andreafontesestudiofotografico@gmail.com"
      ); 
    }
    function isGalleryOwner(bookingId) {
      let bookingData = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return isSignedIn() && bookingData != null && bookingData.clientId == request.auth.uid;
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == adminId && request.auth.token.email == "andreafontesestudiofotografico@gmail.com";
    }

    function isValidUser(data) {
      return data.size() >= 4 && data.size() <= 6
        && data.keys().hasAll(['email', 'name', 'role', 'createdAt'])
        && data.email is string && data.email.size() <= 200
        && data.name is string && data.name.size() <= 200
        && data.role is string && data.role in ['client', 'admin']
        && data.createdAt is timestamp
        && (data.get('phone', '') is string && data.get('phone', '').size() <= 50);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && (incoming().role == 'client' || request.auth.token.email == "andreafontesestudiofotografico@gmail.com");
      
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin())
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() || request.auth.token.email == "andreafontesestudiofotografico@gmail.com") ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone'])
            && incoming().role == existing().role
            && incoming().email == existing().email)
        );
      allow delete: if isAdmin();
    }

    function isValidPackage(data) {
      return data.size() >= 5 && data.size() <= 7
        && data.keys().hasAll(['name', 'price', 'description', 'features', 'isVisible'])
        && data.name is string && data.name.size() <= 100
        && data.price is number
        && data.description is string && data.description.size() <= 1000
        && data.features is list && data.features.size() <= 20 && (data.features.size() == 0 || data.features[0] is string)
        && data.isVisible is bool
        && (data.get('popular', false) is bool);
    }

    match /packages/{packageId} {
      allow get: if isValidId(packageId); // Public read
      allow list: if true; // Public read
      allow create: if isAdmin() && isValidId(packageId) && isValidPackage(incoming());
      allow update: if isAdmin() && isValidId(packageId) && isValidPackage(incoming());
      allow delete: if isAdmin() && isValidId(packageId);
    }

    // CMS rules
    match /cms_packages/{packageId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }
    match /cms_settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }
    match /cms_coupons/{couponId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    function isValidClient(data) {
      return data.size() >= 2 && data.size() <= 8
        && data.keys().hasAll(['name', 'status'])
        && data.name is string && data.name.size() <= 200
        && data.status is string && data.status in ['lead', 'active', 'archived']
        && (data.get('email', '') is string && data.get('email', '').size() <= 200)
        && (data.get('phone', '') is string && data.get('phone', '').size() <= 50)
        && (data.get('notes', '') is string && data.get('notes', '').size() <= 2000)
        && (data.get('uid', '') is string && data.get('uid', '').size() <= 128)
        && (data.get('createdAt', request.time) == request.time);
    }

    match /clients/{clientId} {
      allow get: if isAdmin() && isValidId(clientId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(clientId) && isValidClient(incoming());
      allow update: if isAdmin() && isValidId(clientId) && isValidClient(incoming());
      allow delete: if isAdmin() && isValidId(clientId);
    }

    function isValidContractSnapshot(snap) {
      return snap is map 
        && snap.keys().hasAll(['content', 'version', 'acceptedAt'])
        && snap.content is string
        && snap.content.size() <= 20000
        && snap.version is number
        && snap.acceptedAt is timestamp
        && (snap.get('ipAddress', '') is string && snap.get('ipAddress', '').size() <= 50)
        && (snap.get('userAgent', '') is string && snap.get('userAgent', '').size() <= 500)
        && (snap.get('packageId', '') is string && snap.get('packageId', '').size() <= 128)
        && (snap.get('packageName', '') is string && snap.get('packageName', '').size() <= 200)
        && (snap.get('totalPrice', 0) is number)
        && (snap.get('acceptedTerms', false) is bool);
    }

    function isValidReceiptData(rec) {
      return rec is map
        && rec.keys().hasAll(['receiptNumber', 'issuedBy', 'issuedAt', 'paymentMethod', 'amount', 'clientName', 'clientCpf', 'packageName'])
        && rec.receiptNumber is string && rec.receiptNumber.size() <= 100
        && rec.issuedBy is string && rec.issuedBy.size() <= 200
        && rec.issuedAt is timestamp
        && rec.paymentMethod is string && rec.paymentMethod.size() <= 100
        && rec.amount is number
        && rec.clientName is string && rec.clientName.size() <= 200
        && rec.clientCpf is string && rec.clientCpf.size() <= 20
        && rec.packageName is string && rec.packageName.size() <= 200
        && (rec.get('updatedAt', request.time) is timestamp);
    }

    function isValidBooking(data) {
      return data.size() >= 7 && data.size() <= 27
        && data.keys().hasAll(['clientId', 'packageId', 'status', 'totalPrice', 'createdAt', 'updatedAt'])
        && data.clientId is string && data.clientId.size() <= 128
        && data.packageId is string && data.packageId.size() <= 128
        && data.status is string && data.status in ['pending_payment', 'confirmed', 'session_done', 'in_selection', 'in_editing', 'ready', 'completed', 'cancelled']
        && data.totalPrice is number
        && (data.get('date', '') is string && data.get('date', '').size() <= 50)
        && (data.get('notes', '') is string && data.get('notes', '').size() <= 2000)
        && (data.get('clientName', '') is string && data.get('clientName', '').size() <= 200)
        && (data.get('clientEmail', '') is string && data.get('clientEmail', '').size() <= 200)
        && (data.get('clientPhone', '') is string && data.get('clientPhone', '').size() <= 60)
        && (data.get('cpf', '') is string && data.get('cpf', '').size() <= 20)
        && (data.get('packageName', '') is string && data.get('packageName', '').size() <= 100)
        && (data.get('optionName', '') is string && data.get('optionName', '').size() <= 100)
        && (data.get('contractAccepted', false) is bool)
        && (data.get('contractAcceptedAt', request.time) is timestamp)
        && (data.get('productionSelected', false) is bool)
        && (data.get('productionPrice', 0) is number)
        && (data.get('selectedProductions', []) is list && data.get('selectedProductions', []).size() <= 10)
        && (data.get('couponApplied', '') == null || data.get('couponApplied', '') is string)
        && (data.get('discountAmount', 0) is number)
        && (data.get('subtotal', 0) is number)
        && (data.get('chargedItems', []) is list && data.get('chargedItems', []).size() <= 20)
        && (!('contractSnapshot' in data) || isValidContractSnapshot(data.contractSnapshot))
        && (!('receiptData' in data) || isValidReceiptData(data.receiptData))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookingUpdate(data) {
      return data.size() >= 7 && data.size() <= 27
        && data.keys().hasAll(['clientId', 'packageId', 'status', 'totalPrice', 'createdAt', 'updatedAt'])
        && data.clientId is string && data.clientId.size() <= 128
        && data.packageId is string && data.packageId.size() <= 128
        && data.status is string && data.status in ['pending_payment', 'confirmed', 'session_done', 'in_selection', 'in_editing', 'ready', 'completed', 'cancelled']
        && data.totalPrice is number
        && (data.get('paymentDetails', {}) is map)
        && (data.get('date', '') is string && data.get('date', '').size() <= 50)
        && (data.get('notes', '') is string && data.get('notes', '').size() <= 2000)
        && (data.get('clientName', '') is string && data.get('clientName', '').size() <= 200)
        && (data.get('clientEmail', '') is string && data.get('clientEmail', '').size() <= 200)
        && (data.get('clientPhone', '') is string && data.get('clientPhone', '').size() <= 60)
        && (data.get('cpf', '') is string && data.get('cpf', '').size() <= 20)
        && (data.get('packageName', '') is string && data.get('packageName', '').size() <= 100)
        && (data.get('optionName', '') is string && data.get('optionName', '').size() <= 100)
        && (data.get('contractAccepted', false) is bool)
        && (data.get('contractAcceptedAt', request.time) is timestamp)
        && (data.get('productionSelected', false) is bool)
        && (data.get('productionPrice', 0) is number)
        && (data.get('selectedProductions', []) is list && data.get('selectedProductions', []).size() <= 10)
        && (data.get('couponApplied', '') == null || data.get('couponApplied', '') is string)
        && (data.get('discountAmount', 0) is number)
        && (data.get('subtotal', 0) is number)
        && (data.get('chargedItems', []) is list && data.get('chargedItems', []).size() <= 20)
        && (!('contractSnapshot' in data) || isValidContractSnapshot(data.contractSnapshot))
        && (!('receiptData' in data) || isValidReceiptData(data.receiptData))
        && data.updatedAt is timestamp;
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (isAdmin() || existing().clientId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming())
        && (isAdmin() || incoming().clientId == request.auth.uid);
      allow update: if isSignedIn() && isValidId(bookingId) && isValidBookingUpdate(incoming())
        && (
          isAdmin() ||
          (existing().clientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled')
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    function isValidGallery(data) {
      return data.size() >= 6 && data.size() <= 7
        && data.keys().hasAll(['bookingId', 'clientId', 'name', 'status', 'createdAt', 'updatedAt'])
        && data.bookingId is string && data.bookingId.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.status is string && data.status in ['in_selection', 'awaiting_selection', 'in_editing', 'ready']
        && (data.get('expiresAt', request.time) is timestamp)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isGalleryV2(data) {
      return data.keys().hasAll(['status', 'maxSelections', 'extraPhotoPrice', 'allowExtraSelections', 'createdAt'])
        && data.status in ['UPLOADING', 'READY', 'SELECTING', 'LOCKED', 'PROCESSING', 'DELIVERED'];
    }

    function isValidGalleryUpdate(data) {
      return data.size() >= 6 && data.size() <= 7
        && data.keys().hasAll(['bookingId', 'clientId', 'name', 'status', 'createdAt', 'updatedAt'])
        && data.bookingId is string && data.bookingId.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.status is string && data.status in ['in_selection', 'awaiting_selection', 'in_editing', 'ready']
        && (data.get('expiresAt', request.time) is timestamp)
        && data.updatedAt == request.time;
    }

    match /galleries/{galleryId} {
      allow get: if isSignedIn() && isValidId(galleryId) && (isAdmin() || isGalleryOwner(galleryId) || existing().clientId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || isGalleryOwner(galleryId) || resource.data.clientId == request.auth.uid);
      allow create: if isAdmin() && isValidId(galleryId) && (
        (isValidGallery(incoming()) && exists(/databases/$(database)/documents/bookings/$(incoming().bookingId))) ||
        isGalleryV2(incoming())
      );
      allow update: if isSignedIn() && isValidId(galleryId) && (
        isAdmin() || 
        (existing().clientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'in_editing' && existing().status == 'awaiting_selection') ||
        (isGalleryOwner(galleryId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'selectionLockedAt', 'updatedAt']) && existing().status == 'SELECTING' && incoming().status == 'LOCKED')
      );
      allow delete: if isAdmin() && isValidId(galleryId);

      function isValidPhoto(data) {
        return data.size() >= 4 && data.size() <= 5
          && data.keys().hasAll(['url', 'filename', 'status', 'uploadedAt'])
          && data.url is string && data.url.size() <= 2000
          && data.filename is string && data.filename.size() <= 500
          && data.status is string && data.status in ['raw', 'selected_by_client', 'final']
          && data.uploadedAt == request.time;
      }
      
      function isValidPhotoV2(data) {
        return data.keys().hasAll(['fileName', 'thumbPath', 'previewPath', 'originalPath', 'width', 'height', 'createdAt', 'processingVersion']);
      }
      
      function isValidPhotoUpdate(data) {
        return data.size() >= 4 && data.size() <= 5
          && data.keys().hasAll(['url', 'filename', 'status', 'uploadedAt'])
          && data.url is string && data.url.size() <= 2000
          && data.filename is string && data.filename.size() <= 500
          && data.status is string && data.status in ['raw', 'selected_by_client', 'final'];
      }

      match /photos/{photoId} {
        allow get: if isSignedIn() && isValidId(photoId) && (isAdmin() || isGalleryOwner(galleryId) || get(/databases/$(database)/documents/galleries/$(galleryId)).data.clientId == request.auth.uid);
        allow list: if isSignedIn() && (isAdmin() || isGalleryOwner(galleryId) || get(/databases/$(database)/documents/galleries/$(galleryId)).data.clientId == request.auth.uid);
        allow create: if isAdmin() && isValidId(photoId) && (isValidPhoto(incoming()) || isValidPhotoV2(incoming()));
        allow update: if isSignedIn() && isValidId(photoId) && (
            isAdmin() ||
            (get(/databases/$(database)/documents/galleries/$(galleryId)).data.clientId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
              && get(/databases/$(database)/documents/galleries/$(galleryId)).data.status == 'in_selection')
          );
        allow delete: if isAdmin() && isValidId(photoId);
      }

      match /selections/{photoId} {
        allow get, list: if isSignedIn() && (isAdmin() || isGalleryOwner(galleryId));
        allow create: if isGalleryOwner(galleryId) 
          && get(/databases/$(database)/documents/galleries/$(galleryId)).data.status == 'SELECTING'
          && incoming().keys().hasAll(['selectedAt', 'selectedBy', 'isExtra', 'extraPrice']);
        allow delete: if isGalleryOwner(galleryId) 
          && get(/databases/$(database)/documents/galleries/$(galleryId)).data.status == 'SELECTING';
        allow update: if isAdmin();
      }
    }
  }
}

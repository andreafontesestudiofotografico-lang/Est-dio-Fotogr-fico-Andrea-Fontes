rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "andreafontesestudiofotografico@gmail.com"
      );
    }

    function isGalleryOwner(bookingId) {
      return isSignedIn() && firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid;
    }
    
    // Public assets (if any)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only manageable from console
    }

    // Default Galleries fallback (old structure root files)
    match /galleries/{bookingId}/{fileName} {
      allow write: if isAdmin();
      allow read: if isAdmin() || isGalleryOwner(bookingId);
      // No list permissions mapped 
    }

    // New gallery structure
    match /galleries/{bookingId} {
      
      // thumb - Light grid preview
      match /thumb/{fileName} {
        allow read: if isAdmin() || isGalleryOwner(bookingId);
        allow write, delete: if isAdmin();
      }

      // preview - Light copy with watermark
      match /preview/{fileName} {
        allow read: if isAdmin() || isGalleryOwner(bookingId);
        allow write, delete: if isAdmin();
      }

      // original - Never accessed directly by the client
      match /original/{fileName} {
        allow read, write, delete: if isAdmin();
      }

      // final - Edited photos
      match /final/{fileName} {
        // Future: could allow read for client if releasedAt exists, but for now just basic read
        allow read: if isAdmin() || isGalleryOwner(bookingId);
        allow write, delete: if isAdmin();
      }
    }
  }
}

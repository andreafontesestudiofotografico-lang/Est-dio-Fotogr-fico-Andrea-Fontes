rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin(firestore) {
      return isSignedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    
    // Public assets (if any)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only manageable from console
    }

    // Galleries (Images for clients)
    match /galleries/{bookingId}/{fileName} {
      // Admin can upload, delete, and read anything
      allow write: if isAdmin(firestore);
      
      // Clients can read images from their own galleries.
      // Easiest secure way without passing clientId in custom tokens is verifying the gallery document
      // Note: storage rules firestore access is limited: firestore.get(/databases/(default)/documents/...)
      allow read: if isAdmin(firestore) || (isSignedIn() && firestore.get(/databases/(default)/documents/galleries/$(bookingId)).data.clientId == request.auth.uid);
    }
  }
}
